# ZEMU SIPPAN - Apache Yapılandırması
# SEO Dostu URL Yönlendirmeleri ve Güvenlik Ayarları

# Karakter Seti
AddDefaultCharset UTF-8

# Güvenlik Başlıkları
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    
    # Güvenli Cookie Ayarları
    Header always edit "Set-Cookie" "$0; Secure; HttpOnly; SameSite=Strict"
</IfModule>

# Tarayıcı Önbellekleme
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML - Önbellek yok
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS ve JS - 1 hafta
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    
    # Görseller - 1 ay
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    
    # Fontlar - 1 yıl
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# Gzip Sıkıştırma
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Tek Sayfa Uygulaması (SPA) için Yönlendirme
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # HTTP'yi HTTPS'e yönlendir
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    
    # www'u kaldır
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    
    # Dosya veya klasör değilse index.html'e yönlendir
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# Hassas Dosyaları Koru
<FilesMatch "\.(env|json|lock|md|log|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# robots.txt'e İzin Ver
<Files "robots.txt">
    Order allow,deny
    Allow from all
</FilesMatch>